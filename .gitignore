# Workspace Root .gitignore

# Environment Variables & Secrets
.env
.env.local
*.env
backend/.env
frontend/.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production Builds
frontend/dist/

# Local Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & OS artifacts
*.log
npm-debug.log*
.DS_Store
Thumbs.db
